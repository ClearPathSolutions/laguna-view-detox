# ---------------------------------------------------------------------------
# Laguna View Detox — environment
# Copy to .env.local for local dev; set the real values in Vercel → Settings →
# Environment Variables for Preview and Production.
# ---------------------------------------------------------------------------

# LAUNCH BLOCKER (issues.md T-48).
# Where admissions inquiries are delivered. Until this is set, every lead
# exists only in the platform log and the route logs a CRITICAL line on each
# submission. This carries PHI — point it at a destination covered by a signed
# BAA (CRM endpoint or an inbox relay), not a generic webhook catcher.
LEAD_WEBHOOK_URL=

# GA4 measurement ID, e.g. G-XXXXXXXXXX (issues.md T-04).
# Unset = no analytics script loads at all and every track() call no-ops.
NEXT_PUBLIC_GA_ID=
